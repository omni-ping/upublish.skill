        ],
        "writers": [
          "passcode"
        ],
        "per_identity_limit": null,
        "write_claims": [
          {
            "kind": "passcode",
            "claims": {
              "site": "5b0e3c1a-0000-4000-8000-00000000b001",
              "label": "her"
            }
          }
        ],
        "admin_claims": [
          {
