{
  "route": "visitor.archive",
  "request": {
    "method": "POST",
    "path": "/_data/votes/_archive",
    "headers": {
      "Content-Type": "application/json",
      "Origin": "https://ryan.upubli.sh"
    },
    "body": {}
  },
  "responses": [
    {
      "name": "archived",
      "status": 200,
      "body": {
        "archived": 42
      }
    },
    {
