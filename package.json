{
  "name": "@omniping/upublish",
  "version": "0.12.49",
  "description": "upublish gives everything your AI agent builds a permanent home at your own address: real multi-page sites, free, from any agent.",
  "keywords": [
    "ai-agents",
    "claude-code-plugin",
    "codex",
    "gemini-cli-extension",
    "mcp",
    "mcp-server",
    "publish",
    "static-site-hosting"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./mcp/index.ts"
  },
  "scripts": {
    "test": "bun test lib/",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "files": [
    "mcp/",
    "lib/",
    "dist/",
    "references/",
    "skills/",
    "GEMINI.md",
    "gemini-extension.json",
    "plugin.json",
    "mcp_config.json",
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "codex-mcp.json",
    ".mcp.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omni-ping/upublish.skill"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "open": "^10.2.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "7.0.2"
  }
}
